# Odoo ERP 19.0 API Connection Configuration Template
# Copy this file to .env and fill in your Odoo API key.
# For reference: https://www.odoo.com/documentation/19.0/developer/reference/external_api.html

# Your Odoo Server URL (e.g. https://your-instance.odoo.com)
VITE_ODOO_URL=https://fardin.odoo.com

# Database name
VITE_ODOO_DB=fardin

# Login email or username
VITE_ODOO_LOGIN=aldinn.dev@gmail.com

# Your Odoo User API Key (generated under Odoo Preferences -> Account Security -> Developer API Keys)
VITE_ODOO_API_KEY=your_odoo_api_key_here
